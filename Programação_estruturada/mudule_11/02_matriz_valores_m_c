/*Exercício_02Leia uma matriz 4 x 4, conte e escreva quantos valores maiores
que 10 ela possui.*/

#include <stdio.h>
 
int main(){
    int cont=0;
    int matriz[4][4] = {
        {1, 8, 1, 20},  
        {1, 8, 2, 30},  
        {6, 7, 3, 40},
        {6, 7, 3, 70}
    };
    for (int i = 0; i < 4; i++){
        for (int j = 0; j < 4; j++){
            printf("%d ", matriz[i][j]);//print matriz
            if (matriz[i][j] > 10){
                cont++;
            }    
        }
        printf("\n"); 
    }
    printf("%d", cont);

    return 0;
}